+/// Counts the coded pictures of an Annex-B stream as its bytes are read, so a
+/// caller can pace a feed to the video's length. One slice is one picture on
+/// the streams the vendor app's ffmpeg line produces (x264's default is a
+/// single slice per picture); a stream cut elsewhere can only over-count,
+/// which paces a feed faster than the video.
+#[derive(Debug, Default)]
+pub struct Slices {
+    frames: u64,
+    window: u32,
+    header: bool,
+}
+
+impl Slices {
+    /// Feeds the next block of the stream (any block size, start codes may
+    /// straddle two of them).
+    pub fn push(&mut self, bytes: &[u8]) {
+        for &byte in bytes {
+            if self.header {
+                // A coded slice (1) or an IDR (5) is one picture; SPS (7),
+                // PPS (8), SEI (6) and the rest are not.
+                if matches!(byte & 0x1F, 1 | 5) {
+                    self.frames += 1;
+                }
+                self.header = false;
+                continue;
+            }
+            self.window = (self.window << 8) | u32::from(byte);
+            if self.window & 0x00FF_FFFF == 0x0000_0001 {
+                self.header = true;
+            }
+        }
+    }
+
+    /// Pictures so far.
+    pub fn frames(&self) -> u64 {
+        self.frames
+    }
+}
