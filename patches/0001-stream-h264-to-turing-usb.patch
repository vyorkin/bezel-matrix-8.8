+/// Fills `buf` from `file`, stopping at the file's end (a read may return
+/// fewer bytes than asked for in the middle of a file too).
+fn read_chunk(file: &mut File, buf: &mut [u8]) -> Result<usize> {
+    let mut filled = 0;
+    while filled < buf.len() {
+        let read = file.read(&mut buf[filled..]).map_err(io_err)?;
+        if read == 0 {
+            break;
+        }
+        filled += read;
+    }
+    Ok(filled)
+}
+
+/// The pictures in `file`, whose position is back at the start afterwards:
+/// the length of one pass of the stream, which paces a feed to the video.
+fn count_slices(file: &mut File) -> Result<u64> {
+    let mut slices = proto::Slices::default();
+    let mut block = vec![0u8; 256 * 1024];
+    loop {
+        let read = file.read(&mut block).map_err(io_err)?;
+        if read == 0 {
+            break;
+        }
+        slices.push(&block[..read]);
+    }
+    file.seek(SeekFrom::Start(0)).map_err(io_err)?;
+    Ok(slices.frames())
+}
