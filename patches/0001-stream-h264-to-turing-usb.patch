+/// `bezel stream`: feeds an H.264 file to a screen that decodes a stream
+/// itself (the vendor app's video path, spec § 7) until Ctrl+C. Nothing is
+/// rendered here: the panel shows the video at its own frame rate.
+pub fn stream<B, C>(
+    bus: &B,
+    connector: &C,
+    target: &Target,
+    video: &Path,
+    start: VideoStream,
+) -> anyhow::Result<String>
+where
+    B: DeviceBus + ?Sized,
+    C: ScreenConnector + ?Sized,
+{
+    anyhow::ensure!(
+        video.is_file(),
+        "cannot read {}: not a file",
+        video.display()
+    );
+    let mut link = connect(bus, connector, target)?;
+    let stop = Arc::new(AtomicBool::new(false));
+    let flag = Arc::clone(&stop);
+    ctrlc::set_handler(move || flag.store(true, Ordering::SeqCst))?;
+    let name = describe(link.as_ref());
+    writeln!(
+        std::io::stderr(),
+        "{name}: streaming {} at {} fps; Ctrl+C to stop",
+        video.display(),
+        start.fps
+    )?;
+    link.stream_video(video, start, &stop)?;
+    link.release()?;
+    Ok(format!("{name}: stopped streaming\n"))
+}
